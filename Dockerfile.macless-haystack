FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217 AS builder

ARG MACLESS_HAYSTACK_COMMIT=0bda271b8bd0cc37194dfba1845cd48954cba4cc

COPY deploy/patches/macless-haystack-2fa-idmsa.patch /tmp/macless-haystack-2fa-idmsa.patch

RUN apt-get update \
    && apt-get install --no-install-recommends -y git \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/dchristl/macless-haystack.git /source \
    && git -C /source checkout --detach "$MACLESS_HAYSTACK_COMMIT" \
    && test "$(git -C /source rev-parse HEAD)" = "$MACLESS_HAYSTACK_COMMIT" \
    && git -C /source apply --check /tmp/macless-haystack-2fa-idmsa.patch \
    && git -C /source apply /tmp/macless-haystack-2fa-idmsa.patch \
    && rm -f /source/endpoint/updateRepo /source/endpoint/data/rename_me.pem

FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

WORKDIR /app

COPY deploy/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
    && rm /tmp/requirements.lock

COPY --from=builder /source/endpoint /app/endpoint

CMD ["python", "-u", "endpoint/mh_endpoint.py"]
