# Apple authentication requests use requests' default TLS certificate verification.
diff --git a/endpoint/register/pypush_gsa_icloud.py b/endpoint/register/pypush_gsa_icloud.py
index 694a302..108e8ac 100644
--- a/endpoint/register/pypush_gsa_icloud.py
+++ b/endpoint/register/pypush_gsa_icloud.py
@@ -66,7 +66,6 @@ def icloud_login_mobileme(username='', password=''):
             auth=(username, pet),
             data=data,
             headers=headers,
-            verify=False,
     ) as resp:
         resp.raise_for_status()
     response = f"HTTP-Code: {resp.status_code}\n{resp.text}"
@@ -151,7 +150,6 @@ def gsa_authenticated_request(parameters):
             "https://gsa.apple.com/grandslam/GsService2",
