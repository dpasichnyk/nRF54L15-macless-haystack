+def fetch_report_bytes(query):
+    if not os.path.isfile(mh_config.getConfigFile()):
+        raise InvalidResponse("Apple authentication is missing; run make setup")
+    auth = getAuth(regenerate=False, second_factor='sms')
+    for attempt in range(2):
+        try:
+            with requests.post(
+                FETCH_URL, auth=auth,
+                headers=pypush_gsa_icloud.generate_anisette_headers(),
+                json=search_body(query), timeout=(5, 15), stream=True,
+            ) as response:
+                if response.status_code >= 500 and attempt == 0:
+                    time.sleep(0.25)
+                    continue
+                response.raise_for_status()
+                body = bytearray()
+                for chunk in response.iter_content(chunk_size=65536):
+                    body.extend(chunk)
+                    if len(body) > MAX_RESPONSE_BYTES:
+                        raise InvalidResponse("Upstream response exceeds 4 MiB")
+                if body:
+                    return bytes(body)
+        except requests.exceptions.Timeout:
+            if attempt == 1:
+                raise
+        if attempt == 0:
+            time.sleep(0.25)
+    raise UpstreamUnavailable("Apple returned an empty response")
 
 
